# Names only. Leave secrets empty in git. Put real values in .env.local, which is ignored.
# Local boot does not need cloud credentials. STORE_DRIVER defaults to sqlite under DATA_DIR.

DATA_DIR=./data
STORE_DRIVER=sqlite

# Staff sessions. Minimum 32 characters. Not the bot token.
SESSION_SECRET=

# HMAC key for short-lived signed download URLs. Minimum 32 characters.
ASSET_SIGNING_SECRET=

# Bearer token for POST /api/mcp. Minimum 32 characters. Staff cookies are rejected there.
BOT_WORKER_TOKEN=

# Optional until a Grok Bot routine exists. Server-only. Never send these to the browser.
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_KEY=

# Local UI origin. http://127.0.0.1 is not reachable by the cloud bot, so real dispatch stays blocked.
APP_ORIGIN=http://127.0.0.1:3000

# Used only when the user table is empty. Change the password before starting.
STAFF_BOOTSTRAP_EMAIL=
STAFF_BOOTSTRAP_PASSWORD=

JOB_LEASE_SECONDS=900

# Leave unset. memory-mock boots only with MEMORY_STORE_ACK=test-only outside production.
# MEMORY_STORE_ACK=
# GROK_BOT_WEBHOOK_ALLOW_INSECURE=
